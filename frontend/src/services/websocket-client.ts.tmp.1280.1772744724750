/**
 * WebSocket client service for WebTerm
 * Handles connection management, message encoding/decoding, and reconnection
 */

import {
  BinaryMessageType,
  type BinaryMessageTypeCode,
  type ClientMessage,
  type ServerMessage,
  encodeBinaryMessage,
  decodeBinaryMessage,
} from '@webterm/shared/index';
import type { WebSocketState } from '../types';

/** WebSocket client configuration */
export interface WebSocketClientConfig {
  /** Base URL for WebSocket connection */
  url?: string;
  /** Maximum reconnection attempts */
  maxReconnectAttempts?: number;
  /** Initial reconnection delay in ms */
  initialReconnectDelay?: number;
  /** Maximum reconnection delay in ms */
  maxReconnectDelay?: number;
  /** Reconnection backoff multiplier */
  reconnectBackoffMultiplier?: number;
}

/** Callbacks for WebSocket events */
export interface WebSocketCallbacks {
  /** Called when connection is established */
  onConnect?: () => void;
  /** Called when connection is closed */
  onDisconnect?: (reason?: string) => void;
  /** Called when JSON message is received */
  onMessage?: (message: ServerMessage) => void;
  /** Called when binary output is received */
  onOutput?: (paneId: string, data: Uint8Array) => void;
  /** Called when connection state changes */
  onStateChange?: (state: WebSocketState) => void;
  /** Called on error */
  onError?: (error: Error) => void;
}

/** Backend port for direct WebSocket connection in dev mode */
const DEV_BACKEND_PORT = 9174;

/** Get default WebSocket URL based on environment */
function getDefaultWebSocketUrl(): string {
  // In dev mode, connect directly to backend to bypass Vite proxy
  // (Vite's WS proxy doesn't recover after backend restarts)
  if (import.meta.env.DEV) {
    return `ws://${window.location.hostname}:${DEV_BACKEND_PORT}/ws`;
  }
  const protocol = window.location.protocol === 'https:' ? 'wss:' : 'ws:';
  return `${protocol}//${window.location.host}/ws`;
}

/**
 * WebSocket client for terminal communication
 * Handles binary and JSON protocol with automatic reconnection
 */
export class WebSocketClient {
  private ws: WebSocket | null = null;
  private config: Required<WebSocketClientConfig>;
  private callbacks: WebSocketCallbacks = {};
  private state: WebSocketState = 'disconnected';
  private reconnectAttempts = 0;
  private reconnectTimeout: ReturnType<typeof setTimeout> | null = null;
  private sessionId: string | null = null;
  private intentionalClose = false;

  constructor(config: WebSocketClientConfig = {}) {
    this.config = { ...DEFAULT_CONFIG, ...config };
  }

  /** Current connection state */
  get connectionState(): WebSocketState {
    return this.state;
  }

  /** Current session ID */
  get currentSessionId(): string | null {
    return this.sessionId;
  }

  /** Set callbacks for WebSocket events */
  setCallbacks(callbacks: WebSocketCallbacks): void {
    this.callbacks = { ...this.callbacks, ...callbacks };
  }

  /** Switch to a different session by disconnecting and reconnecting */
  switchSession(newSessionId: string): void {
    this.disconnect();
    this.connect(newSessionId);
  }

  /** Connect to WebSocket server */
  connect(sessionId?: string): void {
    if (this.ws?.readyState === WebSocket.OPEN || this.ws?.readyState === WebSocket.CONNECTING) {
      // Allow reconnection when switching to a different session
      if (sessionId && sessionId !== this.sessionId) {
        this.disconnect();
      } else {
        return;
      }
    }

    this.intentionalClose = false;
    this.sessionId = sessionId ?? null;
    this.setState('connecting');

    // Detach handlers from old socket to prevent ghost events
    if (this.ws) {
      this.ws.onopen = null;
      this.ws.onclose = null;
      this.ws.onerror = null;
      this.ws.onmessage = null;
      this.ws = null;
    }

    const url = new URL(this.config.url);
    if (sessionId) {
      url.searchParams.set('sessionId', sessionId);
    }

    try {
      this.ws = new WebSocket(url.toString());
      this.ws.binaryType = 'arraybuffer';
      this.setupEventHandlers();
    } catch (error) {
      this.handleError(error as Error);
      this.scheduleReconnect();
    }
  }

  /** Disconnect from WebSocket server */
  disconnect(): void {
    this.intentionalClose = true;
    this.clearReconnectTimeout();
    
    if (this.ws) {
      this.ws.close(1000, 'Client disconnect');
      this.ws = null;
    }
    
    this.setState('disconnected');
    this.callbacks.onDisconnect?.('Client initiated disconnect');
  }

  /** Send a JSON control message */
  sendJson(message: ClientMessage): void {
    if (this.ws?.readyState !== WebSocket.OPEN) {
      console.warn('[WebSocketClient] Cannot send message, not connected');
      return;
    }

    try {
      this.ws.send(JSON.stringify(message));
    } catch (error) {
      this.handleError(error as Error);
    }
  }

  /** Send binary data (terminal input) */
  sendBinary(type: BinaryMessageTypeCode, paneId: string, data: Uint8Array): void {
    if (this.ws?.readyState !== WebSocket.OPEN) {
      console.warn('[WebSocketClient] Cannot send binary, not connected');
      return;
    }

    try {
      const message = encodeBinaryMessage(type, paneId, data);
      this.ws.send(message);
    } catch (error) {
      this.handleError(error as Error);
    }
  }

  /** Send terminal input to a pane */
  sendInput(paneId: string, data: string | Uint8Array): void {
    const bytes = typeof data === 'string' 
      ? new TextEncoder().encode(data) 
      : data;
    this.sendBinary(BinaryMessageType.INPUT, paneId, bytes);
  }

  /** Send resize message */
  sendResize(paneId: string, cols: number, rows: number): void {
    this.sendJson({
      type: 'resize',
      payload: { paneId, cols, rows },
    });
  }

  /** Send create pane message */
  sendCreate(windowId: string, shell?: string, cwd?: string): void {
    const payload: { windowId: string; shell?: import('@webterm/shared/index').ShellType; cwd?: string } = {
      windowId,
    };
    if (shell !== undefined) {
      payload.shell = shell as import('@webterm/shared/index').ShellType;
    }
    if (cwd !== undefined) {
      payload.cwd = cwd;
    }
    this.sendJson({
      type: 'create',
      payload,
    });
  }

  /** Send close pane message */
  sendClose(paneId: string): void {
    this.sendJson({
      type: 'close',
      payload: { paneId },
    });
  }

  /** Send split pane message */
  sendSplit(paneId: string, direction: 'h' | 'v', shell?: string): void {
    const payload: { paneId: string; direction: 'h' | 'v'; shell?: import('@webterm/shared/index').ShellType } = {
      paneId,
      direction,
    };
    if (shell !== undefined) {
      payload.shell = shell as import('@webterm/shared/index').ShellType;
    }
    this.sendJson({
      type: 'split',
      payload,
    });
  }

  /** Send focus message */
  sendFocus(paneId: string): void {
    this.sendJson({
      type: 'focus',
      payload: { paneId },
    });
  }

  /** Send broadcast toggle message */
  sendBroadcast(enabled: boolean, paneIds: string[]): void {
    this.sendJson({
      type: 'broadcast',
      payload: { enabled, paneIds },
    });
  }

  /** Send create window message */
  sendCreateWindow(sessionId: string, name?: string): void {
    this.sendJson({
      type: 'createWindow',
      payload: name !== undefined ? { sessionId, name } : { sessionId },
    });
  }

  /** Send close window message */
  sendCloseWindow(windowId: string): void {
    this.sendJson({
      type: 'closeWindow',
      payload: { windowId },
    });
  }

  /** Send switch window message */
  sendSwitchWindow(windowId: string): void {
    this.sendJson({
      type: 'switchWindow',
      payload: { windowId },
    });
  }

  /** Send a tmux command for execution */
  sendExecuteCommand(command: string): void {
    this.sendJson({
      type: 'executeCommand',
      payload: { command },
    });
  }

  /** Send yank-to-buffer message (copy mode yank) */
  sendYankToBuffer(content: string, bufferName?: string): void {
    const payload: { content: string; bufferName?: string } = { content };
    if (bufferName !== undefined) {
      payload.bufferName = bufferName;
    }
    this.sendJson({
      type: 'yankToBuffer',
      payload,
    });
  }

  // ============================================================================
  // Private Methods
  // ============================================================================

  private setupEventHandlers(): void {
    if (!this.ws) return;

    this.ws.onopen = () => {
      this.reconnectAttempts = 0;
      this.setState('connected');
      this.callbacks.onConnect?.();
    };

    this.ws.onclose = (event) => {
      if (!this.intentionalClose) {
        this.callbacks.onDisconnect?.(event.reason || 'Connection closed');
        this.scheduleReconnect();
      }
    };

    this.ws.onerror = () => {
      // Error details not exposed in browser WebSocket API
      this.handleError(new Error('WebSocket error'));
    };

    this.ws.onmessage = (event) => {
      this.handleMessage(event.data);
    };
  }

  private handleMessage(data: string | ArrayBuffer): void {
    try {
      if (data instanceof ArrayBuffer) {
        this.handleBinaryMessage(new Uint8Array(data));
      } else {
        this.handleJsonMessage(data);
      }
    } catch (error) {
      this.handleError(error as Error);
    }
  }

  private handleBinaryMessage(data: Uint8Array): void {
    const { type, paneId, payload } = decodeBinaryMessage(data);
    
    if (type === BinaryMessageType.OUTPUT) {
      this.callbacks.onOutput?.(paneId, payload);
    }
  }

  private handleJsonMessage(data: string): void {
    const message = JSON.parse(data) as ServerMessage;

    // Respond to server heartbeat pings immediately
    if (message.type === 'ping') {
      this.ws?.send(JSON.stringify({ type: 'pong' }));
      return;
    }

    // Handle connected message to store session ID
    if (message.type === 'connected') {
      this.sessionId = message.payload.sessionId;
    }

    this.callbacks.onMessage?.(message);
  }

  private handleError(error: Error): void {
    console.error('[WebSocketClient] Error:', error);
    this.callbacks.onError?.(error);
  }

  private setState(state: WebSocketState): void {
    if (this.state !== state) {
      this.state = state;
      this.callbacks.onStateChange?.(state);
    }
  }

  private scheduleReconnect(): void {
    if (this.intentionalClose) {
      return;
    }

    if (this.reconnectAttempts >= this.config.maxReconnectAttempts) {
      console.warn('[WebSocketClient] Max reconnect attempts reached');
      this.setState('disconnected');
      return;
    }

    this.setState('reconnecting');
    
    const delay = Math.min(
      this.config.initialReconnectDelay * 
        Math.pow(this.config.reconnectBackoffMultiplier, this.reconnectAttempts),
      this.config.maxReconnectDelay
    );
    
    console.log(`[WebSocketClient] Reconnecting in ${delay}ms (attempt ${this.reconnectAttempts + 1})`);
    
    this.reconnectTimeout = setTimeout(() => {
      this.reconnectAttempts++;
      this.connect(this.sessionId ?? undefined);
    }, delay);
  }

  private clearReconnectTimeout(): void {
    if (this.reconnectTimeout) {
      clearTimeout(this.reconnectTimeout);
      this.reconnectTimeout = null;
    }
  }
}

/** Singleton instance */
let clientInstance: WebSocketClient | null = null;

/** Get or create WebSocket client instance */
export function getWebSocketClient(config?: WebSocketClientConfig): WebSocketClient {
  if (!clientInstance) {
    clientInstance = new WebSocketClient(config);
  }
  return clientInstance;
}

/** Reset WebSocket client (for testing) */
export function resetWebSocketClient(): void {
  clientInstance?.disconnect();
  clientInstance = null;
}
