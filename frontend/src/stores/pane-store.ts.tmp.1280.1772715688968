/**
 * Zustand store for pane state management
 * Manages terminal panes, layout, and broadcast mode
 */

import { create } from 'zustand';
import { devtools, subscribeWithSelector } from 'zustand/middleware';
import type { Layout, Pane, ConnectionState } from '@webterm/shared/index';
import type { PaneUIState } from '../types';

// ============================================================================
// Types
// ============================================================================

/** Extended pane with UI state */
export interface PaneWithUI extends Pane {
  ui: PaneUIState;
}

/** Pane store state */
export interface PaneState {
  /** Window ID this store is managing */
  windowId: string | null;
  /** Layout tree for pane arrangement */
  layout: Layout | null;
  /** Map of pane ID to pane data */
  panes: Map<string, PaneWithUI>;
  /** Currently active/focused pane ID */
  activePane: string | null;
  /** Whether the active pane is zoomed */
  zoomedPane: string | null;
  /** Broadcast mode enabled */
  broadcastEnabled: boolean;
  /** Panes included in broadcast */
  broadcastPanes: Set<string>;
}

/** Pane store actions */
export interface PaneActions {
  // Layout actions
  setWindowId: (windowId: string) => void;
  setLayout: (layout: Layout) => void;
  
  // Pane CRUD
  addPane: (pane: Pane) => void;
  removePane: (paneId: string) => void;
  updatePane: (paneId: string, updates: Partial<Pane>) => void;
  
  // Focus management
  setActivePane: (paneId: string | null) => void;
  
  // Pane state updates
  updatePaneState: (paneId: string, state: ConnectionState) => void;
  updatePaneUI: (paneId: string, ui: Partial<PaneUIState>) => void;
  setPaneExitCode: (paneId: string, exitCode: number) => void;
  
  // Zoom management
  toggleZoom: (paneId?: string) => void;
  
  // Broadcast mode
  setBroadcast: (enabled: boolean, paneIds?: string[]) => void;
  toggleBroadcastPane: (paneId: string) => void;
  
  // Bulk operations
  setInitialState: (windowId: string, layout: Layout, panes: Pane[]) => void;
  reset: () => void;
  resetForSessionSwitch: () => void;
}

export type PaneStore = PaneState & PaneActions;

// ============================================================================
// Initial State
// ============================================================================

const initialState: PaneState = {
  windowId: null,
  layout: null,
  panes: new Map(),
  activePane: null,
  zoomedPane: null,
  broadcastEnabled: false,
  broadcastPanes: new Set(),
};

// ============================================================================
// Store Implementation
// ============================================================================

export const usePaneStore = create<PaneStore>()(
  devtools(
    subscribeWithSelector((set, get) => ({
      ...initialState,

      // ======================================================================
      // Layout Actions
      // ======================================================================

      setWindowId: (windowId) => {
        set({ windowId }, false, 'setWindowId');
      },

      setLayout: (layout) => {
        set({ layout }, false, 'setLayout');
      },

      // ======================================================================
      // Pane CRUD
      // ======================================================================

      addPane: (pane) => {
        set(
          (state) => {
            const newPanes = new Map(state.panes);
            newPanes.set(pane.id, {
              ...pane,
              ui: {
                zoomed: false,
                scrollbackLines: 0,
                hasActivity: false,
                isFocused: state.activePane === pane.id,
              },
            });
            return { panes: newPanes };
          },
          false,
          'addPane'
        );
      },

      removePane: (paneId) => {
        set(
          (state) => {
            const newPanes = new Map(state.panes);
            newPanes.delete(paneId);
            
            // Update broadcast panes
            const newBroadcastPanes = new Set(state.broadcastPanes);
            newBroadcastPanes.delete(paneId);
            
            // Update active pane if needed
            const newActivePane = state.activePane === paneId 
              ? getFirstPaneId(newPanes) 
              : state.activePane;
            
            // Update zoomed pane if needed
            const newZoomedPane = state.zoomedPane === paneId 
              ? null 
              : state.zoomedPane;
            
            return {
              panes: newPanes,
              broadcastPanes: newBroadcastPanes,
              activePane: newActivePane,
              zoomedPane: newZoomedPane,
            };
          },
          false,
          'removePane'
        );
      },

      updatePane: (paneId, updates) => {
        set(
          (state) => {
            const pane = state.panes.get(paneId);
            if (!pane) return state;
            
            const newPanes = new Map(state.panes);
            newPanes.set(paneId, { ...pane, ...updates, ui: pane.ui });
            return { panes: newPanes };
          },
          false,
          'updatePane'
        );
      },

      // ======================================================================
      // Focus Management
      // ======================================================================

      setActivePane: (paneId) => {
        set(
          (state) => {
            const newPanes = new Map(state.panes);
            
            // Update focus state on all panes
            for (const [id, pane] of newPanes) {
              if (pane.ui.isFocused !== (id === paneId)) {
                newPanes.set(id, {
                  ...pane,
                  ui: { ...pane.ui, isFocused: id === paneId },
                });
              }
            }
            
            return { 
              activePane: paneId,
              panes: newPanes,
            };
          },
          false,
          'setActivePane'
        );
      },

      // ======================================================================
      // Pane State Updates
      // ======================================================================

      updatePaneState: (paneId, connectionState) => {
        set(
          (state) => {
            const pane = state.panes.get(paneId);
            if (!pane) return state;
            
            const newPanes = new Map(state.panes);
            newPanes.set(paneId, { ...pane, connectionState });
            return { panes: newPanes };
          },
          false,
          'updatePaneState'
        );
      },

      updatePaneUI: (paneId, ui) => {
        set(
          (state) => {
            const pane = state.panes.get(paneId);
            if (!pane) return state;
            
            const newPanes = new Map(state.panes);
            newPanes.set(paneId, { 
              ...pane, 
              ui: { ...pane.ui, ...ui },
            });
            return { panes: newPanes };
          },
          false,
          'updatePaneUI'
        );
      },

      setPaneExitCode: (paneId, exitCode) => {
        set(
          (state) => {
            const pane = state.panes.get(paneId);
            if (!pane) return state;
            
            const newPanes = new Map(state.panes);
            newPanes.set(paneId, { 
              ...pane, 
              exitCode,
              connectionState: 'exited',
            });
            return { panes: newPanes };
          },
          false,
          'setPaneExitCode'
        );
      },

      // ======================================================================
      // Zoom Management
      // ======================================================================

      toggleZoom: (paneId) => {
        set(
          (state) => {
            const targetId = paneId ?? state.activePane;
            if (!targetId) return state;
            
            const newZoomedPane = state.zoomedPane === targetId ? null : targetId;
            
            // Update UI state on panes
            const newPanes = new Map(state.panes);
            for (const [id, pane] of newPanes) {
              const isZoomed = id === newZoomedPane;
              if (pane.ui.zoomed !== isZoomed) {
                newPanes.set(id, {
                  ...pane,
                  ui: { ...pane.ui, zoomed: isZoomed },
                });
              }
            }
            
            return { 
              zoomedPane: newZoomedPane,
              panes: newPanes,
            };
          },
          false,
          'toggleZoom'
        );
      },

      // ======================================================================
      // Broadcast Mode
      // ======================================================================

      setBroadcast: (enabled, paneIds) => {
        set(
          (state) => {
            const newBroadcastPanes = paneIds 
              ? new Set(paneIds)
              : enabled 
                ? new Set(state.panes.keys())
                : new Set<string>();
            
            return {
              broadcastEnabled: enabled,
              broadcastPanes: newBroadcastPanes,
            };
          },
          false,
          'setBroadcast'
        );
      },

      toggleBroadcastPane: (paneId) => {
        set(
          (state) => {
            const newBroadcastPanes = new Set(state.broadcastPanes);
            if (newBroadcastPanes.has(paneId)) {
              newBroadcastPanes.delete(paneId);
            } else {
              newBroadcastPanes.add(paneId);
            }
            
            return {
              broadcastPanes: newBroadcastPanes,
              // Disable broadcast if no panes selected
              broadcastEnabled: newBroadcastPanes.size > 0 
                ? state.broadcastEnabled 
                : false,
            };
          },
          false,
          'toggleBroadcastPane'
        );
      },

      // ======================================================================
      // Bulk Operations
      // ======================================================================

      setInitialState: (windowId, layout, panes) => {
        const panesMap = new Map<string, PaneWithUI>();
        const firstPaneId = panes[0]?.id ?? null;
        
        for (const pane of panes) {
          panesMap.set(pane.id, {
            ...pane,
            ui: {
              zoomed: false,
              scrollbackLines: 0,
              hasActivity: false,
              isFocused: pane.id === firstPaneId,
            },
          });
        }
        
        set(
          {
            windowId,
            layout,
            panes: panesMap,
            activePane: firstPaneId,
            zoomedPane: null,
            broadcastEnabled: false,
            broadcastPanes: new Set(),
          },
          false,
          'setInitialState'
        );
      },

      reset: () => {
        set(initialState, false, 'reset');
      },
    })),
    { name: 'pane-store' }
  )
);

// ============================================================================
// Selectors
// ============================================================================

/** Get pane by ID */
export const selectPane = (paneId: string) => 
  (state: PaneStore) => state.panes.get(paneId);

/** Get active pane */
export const selectActivePane = (state: PaneStore) => 
  state.activePane ? state.panes.get(state.activePane) : null;

/** Get all panes as array */
export const selectPanesArray = (state: PaneStore) => 
  Array.from(state.panes.values());

/** Get connected panes */
export const selectConnectedPanes = (state: PaneStore) => 
  Array.from(state.panes.values())
    .filter(pane => pane.connectionState === 'connected');

/** Get broadcast pane IDs as array */
export const selectBroadcastPaneIds = (state: PaneStore) => 
  Array.from(state.broadcastPanes);

/** Check if a pane is in broadcast mode */
export const selectIsPaneBroadcasting = (paneId: string) => 
  (state: PaneStore) => state.broadcastEnabled && state.broadcastPanes.has(paneId);

/** Get zoomed pane if any */
export const selectZoomedPane = (state: PaneStore) => 
  state.zoomedPane ? state.panes.get(state.zoomedPane) : null;

// ============================================================================
// Helpers
// ============================================================================

function getFirstPaneId(panes: Map<string, PaneWithUI>): string | null {
  const firstKey = panes.keys().next();
  return firstKey.done ? null : firstKey.value;
}
