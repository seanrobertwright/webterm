/**
 * Zustand store for session state management
 * Manages sessions, windows, and saved session list
 */

import { create } from 'zustand';
import { devtools, persist, subscribeWithSelector } from 'zustand/middleware';
import type { 
  Session, 
  SessionWithWindows, 
  WindowWithPanes,
  SessionListItem,
} from '@webterm/shared/index';

// ============================================================================
// Types
// ============================================================================

/** Session store state */
export interface SessionState {
  /** Currently active session (with full details) */
  currentSession: SessionWithWindows | null;
  /** List of windows in current session */
  windows: WindowWithPanes[];
  /** Currently active window ID */
  activeWindowId: string | null;
  /** List of saved sessions (for session picker) */
  savedSessions: SessionListItem[];
  /** Loading state */
  isLoading: boolean;
  /** Error state */
  error: string | null;
}

/** Session store actions */
export interface SessionActions {
  // Session management
  setSession: (session: SessionWithWindows) => void;
  updateSession: (updates: Partial<Session>) => void;
  clearSession: () => void;
  
  // Window management
  addWindow: (window: WindowWithPanes) => void;
  removeWindow: (windowId: string) => void;
  updateWindow: (windowId: string, updates: Partial<WindowWithPanes>) => void;
  setActiveWindow: (windowId: string) => void;
  
  // Saved sessions
  setSavedSessions: (sessions: SessionListItem[]) => void;
  addSavedSession: (session: SessionListItem) => void;
  removeSavedSession: (sessionId: string) => void;
  updateSavedSession: (sessionId: string, updates: Partial<SessionListItem>) => void;
  
  // Status
  setLoading: (isLoading: boolean) => void;
  setError: (error: string | null) => void;
  
  // Reset
  reset: () => void;
  resetForSessionSwitch: () => void;
}

export type SessionStore = SessionState & SessionActions;

// ============================================================================
// Initial State
// ============================================================================

const initialState: SessionState = {
  currentSession: null,
  windows: [],
  activeWindowId: null,
  savedSessions: [],
  isLoading: false,
  error: null,
};

// ============================================================================
// Store Implementation
// ============================================================================

export const useSessionStore = create<SessionStore>()(
  devtools(
    subscribeWithSelector(
      persist(
        (set, get) => ({
          ...initialState,

          // ==================================================================
          // Session Management
          // ==================================================================

          setSession: (session) => {
            set(
              {
                currentSession: session,
                windows: session.windows,
                activeWindowId: session.activeWindowId ?? session.windows[0]?.id ?? null,
                error: null,
              },
              false,
              'setSession'
            );
          },

          updateSession: (updates) => {
            set(
              (state) => {
                if (!state.currentSession) return state;
                
                return {
                  currentSession: {
                    ...state.currentSession,
                    ...updates,
                    updatedAt: Date.now(),
                  },
                };
              },
              false,
              'updateSession'
            );
          },

          clearSession: () => {
            set(
              {
                currentSession: null,
                windows: [],
                activeWindowId: null,
              },
              false,
              'clearSession'
            );
          },

          // ==================================================================
          // Window Management
          // ==================================================================

          addWindow: (window) => {
            set(
              (state) => {
                const newWindows = [...state.windows, window];
                const newSession = state.currentSession
                  ? {
                      ...state.currentSession,
                      windows: newWindows,
                      updatedAt: Date.now(),
                    }
                  : null;
                
                return {
                  windows: newWindows,
                  currentSession: newSession,
                  // Set as active if it's the first window
                  activeWindowId: state.activeWindowId ?? window.id,
                };
              },
              false,
              'addWindow'
            );
          },

          removeWindow: (windowId) => {
            set(
              (state) => {
                const newWindows = state.windows.filter(w => w.id !== windowId);
                const newSession = state.currentSession
                  ? {
                      ...state.currentSession,
                      windows: newWindows,
                      updatedAt: Date.now(),
                    }
                  : null;
                
                // Update active window if needed
                let newActiveWindowId = state.activeWindowId;
                if (state.activeWindowId === windowId) {
                  newActiveWindowId = newWindows[0]?.id ?? null;
                }
                
                return {
                  windows: newWindows,
                  currentSession: newSession,
                  activeWindowId: newActiveWindowId,
                };
              },
              false,
              'removeWindow'
            );
          },

          updateWindow: (windowId, updates) => {
            set(
              (state) => {
                const windowIndex = state.windows.findIndex(w => w.id === windowId);
                if (windowIndex === -1) return state;
                
                const newWindows = [...state.windows];
                newWindows[windowIndex] = {
                  ...newWindows[windowIndex]!,
                  ...updates,
                };
                
                const newSession = state.currentSession
                  ? {
                      ...state.currentSession,
                      windows: newWindows,
                      updatedAt: Date.now(),
                    }
                  : null;
                
                return {
                  windows: newWindows,
                  currentSession: newSession,
                };
              },
              false,
              'updateWindow'
            );
          },

          setActiveWindow: (windowId) => {
            set(
              (state) => {
                // Verify window exists
                const windowExists = state.windows.some(w => w.id === windowId);
                if (!windowExists) return state;

                // Clear monitoring flags on the window being switched to
                const newWindows = state.windows.map(w =>
                  w.id === windowId
                    ? { ...w, activityFlag: false, bellFlag: false, silenceFlag: false }
                    : w
                );

                const newSession = state.currentSession
                  ? {
                      ...state.currentSession,
                      windows: newWindows,
                      activeWindowId: windowId,
                      updatedAt: Date.now(),
                    }
                  : null;

                return {
                  windows: newWindows,
                  activeWindowId: windowId,
                  currentSession: newSession,
                };
              },
              false,
              'setActiveWindow'
            );
          },

          // ==================================================================
          // Saved Sessions
          // ==================================================================

          setSavedSessions: (sessions) => {
            set({ savedSessions: sessions }, false, 'setSavedSessions');
          },

          addSavedSession: (session) => {
            set(
              (state) => ({
                savedSessions: [...state.savedSessions, session],
              }),
              false,
              'addSavedSession'
            );
          },

          removeSavedSession: (sessionId) => {
            set(
              (state) => ({
                savedSessions: state.savedSessions.filter(s => s.id !== sessionId),
              }),
              false,
              'removeSavedSession'
            );
          },

          updateSavedSession: (sessionId, updates) => {
            set(
              (state) => {
                const index = state.savedSessions.findIndex(s => s.id === sessionId);
                if (index === -1) return state;
                
                const newSessions = [...state.savedSessions];
                newSessions[index] = { ...newSessions[index]!, ...updates };
                
                return { savedSessions: newSessions };
              },
              false,
              'updateSavedSession'
            );
          },

          // ==================================================================
          // Status
          // ==================================================================

          setLoading: (isLoading) => {
            set({ isLoading }, false, 'setLoading');
          },

          setError: (error) => {
            set({ error }, false, 'setError');
          },

          // ==================================================================
          // Reset
          // ==================================================================

          reset: () => {
            set(initialState, false, 'reset');
          },
        }),
        {
          name: 'webterm-session-store',
          partialize: (state) => ({
            // Only persist saved sessions list, not current session
            savedSessions: state.savedSessions,
          }),
        }
      )
    ),
    { name: 'session-store' }
  )
);

// ============================================================================
// Selectors
// ============================================================================

/** Get current session */
export const selectCurrentSession = (state: SessionStore) => state.currentSession;

/** Get active window */
export const selectActiveWindow = (state: SessionStore) => 
  state.windows.find(w => w.id === state.activeWindowId);

/** Get window by ID */
export const selectWindow = (windowId: string) => 
  (state: SessionStore) => state.windows.find(w => w.id === windowId);

/** Get windows sorted by index */
export const selectSortedWindows = (state: SessionStore) => 
  [...state.windows].sort((a, b) => a.index - b.index);

/** Get window count */
export const selectWindowCount = (state: SessionStore) => state.windows.length;

/** Get saved sessions */
export const selectSavedSessions = (state: SessionStore) => state.savedSessions;

/** Get saved session by ID */
export const selectSavedSession = (sessionId: string) => 
  (state: SessionStore) => state.savedSessions.find(s => s.id === sessionId);

/** Check if a session is active */
export const selectIsSessionActive = (sessionId: string) => 
  (state: SessionStore) => state.currentSession?.id === sessionId;

/** Get loading state */
export const selectIsLoading = (state: SessionStore) => state.isLoading;

/** Get error state */
export const selectError = (state: SessionStore) => state.error;

// ============================================================================
// Derived Selectors
// ============================================================================

/** Get next window in sequence */
export const selectNextWindow = (state: SessionStore) => {
  const currentIndex = state.windows.findIndex(w => w.id === state.activeWindowId);
  if (currentIndex === -1 || state.windows.length === 0) return null;
  
  const nextIndex = (currentIndex + 1) % state.windows.length;
  return state.windows[nextIndex] ?? null;
};

/** Get previous window in sequence */
export const selectPrevWindow = (state: SessionStore) => {
  const currentIndex = state.windows.findIndex(w => w.id === state.activeWindowId);
  if (currentIndex === -1 || state.windows.length === 0) return null;
  
  const prevIndex = (currentIndex - 1 + state.windows.length) % state.windows.length;
  return state.windows[prevIndex] ?? null;
};
