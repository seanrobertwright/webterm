{
  "name": "webterm",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev -w @webterm/backend",
    "dev:frontend": "npm run dev -w @webterm/frontend",
    "build": "npm run build -w @webterm/shared && npm run build -w @webterm/backend && npm run build -w @webterm/frontend",
    "build:shared": "npm run build -w @webterm/shared",
    "test": "npm run test -ws",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck -ws"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "concurrently": "^9.1.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.0"
  }
}
