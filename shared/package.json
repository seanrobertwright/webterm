{
  "name": "@webterm/shared",
  "version": "1.0.0",
  "type": "module",
  "main": "types/index.ts",
  "types": "types/index.ts",
  "exports": {
    ".": {
      "types": "./types/index.ts",
      "import": "./types/index.ts",
      "default": "./types/index.ts"
    },
    "./*": {
      "types": "./types/*.ts",
      "import": "./types/*.ts",
      "default": "./types/*.ts"
    },
    "./tmux/*": {
      "types": "./tmux/*.ts",
      "import": "./tmux/*.ts",
      "default": "./tmux/*.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  }
}
