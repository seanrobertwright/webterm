/**
 * Session REST endpoints
 * /api/v1/sessions
 */

import type { IncomingMessage, ServerResponse } from 'node:http';
import { sendJson, sendError } from '../rest-router.js';
import { logger } from '../../utils/logger.js';
import {
  NotFoundError,
  ValidationError,
  DuplicateError,
  toErrorResponse,
} from '../../utils/errors.js';
import { randomUUID } from 'node:crypto';
import type {
  Session,
  SessionWithWindows,
  SessionListItem,
  WindowWithPanes,
} from '@webterm/shared/models';
import { sessionService } from '../../services/session-service.js';

// ============================================================================
// In-Memory Session Store (placeholder until database is implemented)
// ============================================================================

interface SessionStore {
  sessions: Map<string, SessionWithWindows>;
}

const store: SessionStore = {
  sessions: new Map(),
};

/**
 * Get session by ID
 */
function getSessionById(id: string): SessionWithWindows | undefined {
  return store.sessions.get(id);
}

/**
 * Get session by name
 */
function getSessionByName(name: string): SessionWithWindows | undefined {
  for (const session of store.sessions.values()) {
    if (session.name === name) {
      return session;
    }
  }
  return undefined;
}

/**
 * Count panes in a session
 */
function countPanes(session: SessionWithWindows): number {
  return session.windows.reduce((count, window) => count + window.panes.length, 0);
}

// ============================================================================
// Route Handlers
// ============================================================================

/**
 * GET /api/v1/sessions
 * List all sessions
 */
export async function handleListSessions(
  _req: IncomingMessage,
  res: ServerResponse,
  _params: Record<string, string>,
  _body: unknown
): Promise<void> {
  logger.debug('Listing sessions');

  const sessions = sessionService.getAllSessions();

  // Sort by updatedAt descending
  sessions.sort((a, b) => b.updatedAt - a.updatedAt);

  sendJson(res, 200, sessions);
}

/**
 * GET /api/v1/sessions/:id
 * Get session details
 */
export async function handleGetSession(
  _req: IncomingMessage,
  res: ServerResponse,
  params: Record<string, string>,
  _body: unknown
): Promise<void> {
  const id = params['id'] ?? '';

  logger.debug('Getting session', { id });

  const session = sessionService.getSession(id);

  if (!session) {
    throw new NotFoundError('Session', id);
  }

  sendJson(res, 200, session);
}

/**
 * POST /api/v1/sessions
 * Create new session
 */
export async function handleCreateSession(
  _req: IncomingMessage,
  res: ServerResponse,
  _params: Record<string, string>,
  body: unknown
): Promise<void> {
  logger.debug('Creating session', { body });

  // Validate body
  if (!body || typeof body !== 'object') {
    throw new ValidationError('Request body is required', 'body', 'required');
  }

  const { name } = body as { name?: string };

  if (!name || typeof name !== 'string') {
    throw new ValidationError('Session name is required', 'name', 'required');
  }

  if (name.length < 1 || name.length > 100) {
    throw new ValidationError('Session name must be 1-100 characters', 'name', 'length');
  }

  // Check for duplicate name
  if (sessionService.sessionNameExists(name)) {
    throw new DuplicateError('Session', 'name', name);
  }

  // Create session via service (persists to SQLite)
  const session = sessionService.createSession({ name });

  logger.info('Session created', { id: session.id, name: session.name });

  // Return created session
  const response: Session = {
    id: session.id,
    name: session.name,
    createdAt: session.createdAt,
    updatedAt: session.updatedAt,
    activeWindowId: session.activeWindowId,
    lastWindowId: session.lastWindowId ?? null,
  };

  sendJson(res, 201, response);
}

/**
 * PATCH /api/v1/sessions/:id
 * Update session
 */
export async function handleUpdateSession(
  _req: IncomingMessage,
  res: ServerResponse,
  params: Record<string, string>,
  body: unknown
): Promise<void> {
  const id = params['id'] ?? '';

  logger.debug('Updating session', { id, body });

  const session = sessionService.getSession(id);

  if (!session) {
    throw new NotFoundError('Session', id);
  }

  // Validate body
  if (!body || typeof body !== 'object') {
    throw new ValidationError('Request body is required', 'body', 'required');
  }

  const { name } = body as { name?: string };

  // Update name if provided
  if (name !== undefined) {
    if (typeof name !== 'string' || name.length < 1 || name.length > 100) {
      throw new ValidationError('Session name must be 1-100 characters', 'name', 'length');
    }

    // Check for duplicate name (excluding current session)
    if (sessionService.sessionNameExists(name, id)) {
      throw new DuplicateError('Session', 'name', name);
    }
  }

  sessionService.updateSession(id, { name });

  logger.info('Session updated', { id, name });

  // Re-fetch updated session
  const updated = sessionService.getSession(id);
  if (!updated) {
    throw new NotFoundError('Session', id);
  }

  const response: Session = {
    id: updated.id,
    name: updated.name,
    createdAt: updated.createdAt,
    updatedAt: updated.updatedAt,
    activeWindowId: updated.activeWindowId,
    lastWindowId: updated.lastWindowId ?? null,
  };

  sendJson(res, 200, response);
}

/**
 * DELETE /api/v1/sessions/:id
 * Delete session
 */
export async function handleDeleteSession(
  _req: IncomingMessage,
  res: ServerResponse,
  params: Record<string, string>,
  _body: unknown
): Promise<void> {
  const id = params['id'] ?? '';

  logger.debug('Deleting session', { id });

  const session = getSessionById(id);

  if (!session) {
    throw new NotFoundError('Session', id);
  }

  // TODO: Close all panes and windows first
  // for (const window of session.windows) {
  //   for (const pane of window.panes) {
  //     await ptyService.closePane(pane.id);
  //   }
  // }

  store.sessions.delete(id);

  logger.info('Session deleted', { id });

  res.statusCode = 204;
  res.end();
}

/**
 * POST /api/v1/sessions/:id/save
 * Save current session state
 */
export async function handleSaveSession(
  _req: IncomingMessage,
  res: ServerResponse,
  params: Record<string, string>,
  _body: unknown
): Promise<void> {
  const id = params['id'] ?? '';

  logger.debug('Saving session', { id });

  const session = getSessionById(id);

  if (!session) {
    throw new NotFoundError('Session', id);
  }

  // Update timestamp
  session.updatedAt = Date.now();

  // TODO: Persist session state to database
  // await database.saveSession(session);

  logger.info('Session saved', { id });

  // Return session summary
  const response: SessionListItem = {
    id: session.id,
    name: session.name,
    createdAt: session.createdAt,
    updatedAt: session.updatedAt,
    windowCount: session.windows.length,
    paneCount: countPanes(session),
  };

  sendJson(res, 200, response);
}

// ============================================================================
// Session Store Helpers (for use by other modules)
// ============================================================================

/**
 * Add or update a session in the store
 */
export function setSession(session: SessionWithWindows): void {
  store.sessions.set(session.id, session);
}

/**
 * Get a session from the store
 */
export function getSession(id: string): SessionWithWindows | undefined {
  return store.sessions.get(id);
}

/**
 * Add a window to a session
 */
export function addWindowToSession(sessionId: string, window: WindowWithPanes): void {
  const session = store.sessions.get(sessionId);
  if (session) {
    session.windows.push(window);
    session.updatedAt = Date.now();
    if (!session.activeWindowId) {
      session.activeWindowId = window.id;
    }
  }
}

/**
 * Remove a window from a session
 */
export function removeWindowFromSession(sessionId: string, windowId: string): void {
  const session = store.sessions.get(sessionId);
  if (session) {
    session.windows = session.windows.filter((w) => w.id !== windowId);
    session.updatedAt = Date.now();
    if (session.activeWindowId === windowId) {
      session.activeWindowId = session.windows[0]?.id ?? null;
    }
  }
}
